# Server-only on /opt/aomx/ingest.env (chmod 600); never put these in a Godot export.
AOMX_DATABASE_URL=postgresql://aomx_ingest:REPLACE@postgres:5432/aomx
GOLDEN_FRIJOLES_ENVIRONMENT=preview
GOLDEN_FRIJOLES_FLAG_READ_KEY=REPLACE
GOLDEN_FRIJOLES_URL=https://goldenfrijoles.com
# Campaign access stays off until this independently verified aomx ingest key is set.
AOMX_GROWTH_ENGINE_API_KEY=REPLACE
AOMX_VERIFIED_PROJECT=aomx
AOMX_VERIFIED_KEY_SHA256=REPLACE
AOMX_PORT=8787
