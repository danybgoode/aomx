# Owner-only /opt/aomx/operator.env (chmod 600), separate from ingest.env.
AOMX_DATABASE_URL=postgresql://aomx_admin:REPLACE@127.0.0.1:55433/aomx
AOMX_BACKUP_DATABASE_URL=postgresql://aomx_admin:REPLACE@127.0.0.1:55433/aomx
AOMX_RESTORE_DATABASE_URL=postgresql://aomx_admin:REPLACE@127.0.0.1:55433/aomx_restore_test
AOMX_OCI_AUTH=instance_principal
AOMX_OCI_NAMESPACE=axpjoxbihw8m
AOMX_BACKUP_BUCKET=aomx-backups
AOMX_PG_DOCKER_CONTAINER=aomx-postgres-1
AOMX_INGEST_DOCKER_CONTAINER=aomx-ingest-1
AOMX_PUBLIC_HEALTH_URL=https://alpha-api.159.54.158.4.sslip.io/healthz
# Campaign adoption publisher only. Keep this cursor outside the repo.
AOMX_CAMPAIGN_CURSOR_PATH=/opt/aomx/campaign-publish-cursor.json
AOMX_GROWTH_ENGINE_API_KEY=REPLACE
AOMX_VERIFIED_PROJECT=aomx
AOMX_VERIFIED_CAMPAIGN_KEY_SCRYPT=REPLACE
GOLDEN_FRIJOLES_URL=https://goldenfrijoles.com
# Owner-controlled alert sink. OCI topic ID is not a secret; its email
# subscription must be confirmed before delivery. Keep the state file on the VM.
AOMX_ALERT_TOPIC_ID=ocid1.onstopic.oc1.REGION.REPLACE
AOMX_ALERT_STATE_PATH=/opt/aomx/alert-state.json
