# Add this site to panfleto's Caddyfile only after its Caddy service is also
# attached to the separate aomx_proxy network. Replace the hostname and
# operator CIDR first. Broader access requires a separate release review.
alpha-api.example.com {
  encode zstd gzip
  @operator remote_ip REPLACE_WITH_OPERATOR_CIDR
  handle @operator {
    reverse_proxy aomx-ingest:8787
  }
  handle {
    respond 403
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
}
